---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/site';
export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}
const { project } = Astro.props;
---
<Layout title={`${project.name} — Ferlione`} description={project.summary}><section class="case-hero"><div class={`case-hero__art ${project.accent}`} aria-hidden="true"><strong>{project.name.charAt(0)}</strong></div><div class="case-hero__copy"><p class="section-label">{project.category} · {project.year}</p><h1>{project.name}</h1><p>{project.summary}</p><a class="button" href="/#contacto">¿Tienes un reto parecido? <span>↗</span></a></div></section><section class="case-detail"><h2>Una web clara empieza por un problema bien definido.</h2><div class="case-detail__body"><h3>El reto</h3><p>{project.challenge}</p><h3>El enfoque</h3><p>{project.approach}</p><h3>El resultado</h3><p>{project.result}</p><h3>Entregables</h3><ul class="deliverables">{project.deliverables.map((item) => <li>{item}</li>)}</ul><p class="form-note">Caso conceptual para validar la estructura del portfolio. Será reemplazado por un proyecto real cuando esté autorizado para publicación.</p></div></section></Layout>
