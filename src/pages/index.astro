---

import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import {
	pricingPlans,
	problems,
	processSteps,
	projects,
	services,
} from '../data/site';

const technologyGroups = [
	{
		title: 'Frontend',
		items: [
			'HTML',
			'CSS',
			'JavaScript',
			'TypeScript',
			'React',
			'TanStack Router',
			'TanStack Query',
			'Next.js',
			'Tailwind CSS',
			'GSAP',
			'Bun',
			'Vite',
			'Biome',
		],
	},
	{
		title: 'Backend',
		items: ['Python', 'FastAPI', 'Django', 'Django REST Framework', 'JWT'],
	},
	{
		title: 'Bases de datos',
		items: ['SQL', 'PostgreSQL', 'SQLite'],
	},
	{
		title: 'Inteligencia artificial',
		items: ['LangChain', 'PyTorch', 'MCP', 'Scikit-learn', 'OpenCV', 'Gradio'],
	},
];
---
<Layout>
  <section class="hero"><div><p class="section-label">Desarrollo web · Argentina y remoto</p><h1>La web que tu negocio necesita para <em>avanzar.</em></h1><div class="hero__copy"><p>Ferlione desarrolla webs desde cero para negocios y profesionales. Si tienes una idea, la convertimos en un proyecto. Si todavía no está definida, te ayudamos a construirla.</p><div class="hero__actions"><a class="button" href="#contacto">Cuéntame tu idea <span>↗</span></a><a class="button button--outline" href="#trabajo">Ver trabajo</a></div></div></div></section>
  <div class="band"><div class="band__track"><span>ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span></div></div>
  <section id="trabajo" class="section section--work"><div class="section__intro"><div><p class="section-label">Trabajo seleccionado</p><h2>Proyectos con una razón para existir.</h2></div><p>Una selección editorial de trabajos y casos conceptuales. Cada proyecto conecta un problema, unas decisiones y un resultado.</p></div><div class="projects-grid">{projects.map((project, index) => <ProjectShowcase project={project} index={index} />)}</div></section>
  <section class="section section--muted"><div class="split-grid"><div><p class="section-label">Problemas reconocibles</p><h2>Tu web debería ayudarte a explicar y vender.</h2><p class="split-grid__aside">Una buena web no empieza por la tecnología. Empieza por entender qué necesita decidir la persona que la visita.</p></div><ul class="problem-list">{problems.map((problem) => <li>{problem}</li>)}</ul></div></section>
  <section id="servicios" class="section"><div class="section__intro"><div><p class="section-label">Cómo podemos trabajar</p><h2>Una solución para cada punto de partida.</h2></div><p>Elegimos el alcance según lo que el negocio necesita resolver. Puedes llegar con una idea clara o con un problema que todavía necesita estructura.</p></div><div class="service-grid">{services.map((service) => <article class="service-item"><span class="service-item__number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><div class="tag-row">{service.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div><div class="split-grid services-modes"><div><p class="section-label">Dos formas de empezar</p><h2>La idea puede estar clara o todavía no.</h2></div><div class="case-detail__body"><h3>Proyecto puntual</h3><p>Definimos alcance, entregables, calendario y puesta en marcha para construir una web concreta.</p><h3>Colaboración mensual</h3><p>Priorizamos soporte, contenido, optimización o nuevas funcionalidades según lo que el negocio necesite cada mes.</p></div></div></section>
  <section id="precios" class="section section--pricing"><div class="section__intro"><div><p class="section-label">Formas de trabajar</p><h2>Una presencia que genera confianza.</h2></div><p>Elegimos el alcance según el momento de tu negocio: empezar a captar consultas, mejorar una web existente, presentar tu experiencia o construir un sistema a medida.</p></div><div class="pricing-grid">{pricingPlans.map((plan) => <article class:list={["pricing-card", { featured: plan.featured }]}><p class="pricing-card__label">{plan.label}</p><h3>{plan.title}</h3><p class="pricing-card__description">{plan.description}</p><div class="pricing-card__meta"><p><strong>Resuelve</strong>{plan.problem}</p><p><strong>Pensado para</strong>{plan.audience}</p></div><p class="pricing-card__price">A medida</p><ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class="pricing-card__link" href="#contacto">{plan.cta} <span>↗</span></a></article>)}</div></section>
  <section id="sobre-ferlione" class="section section--muted"><div class="split-grid"><div><p class="section-label">Sobre Ferlione</p><h2>La fuerza está en la estructura.</h2></div><div class="case-detail__body"><p>Ferlione nace para ayudar a negocios y profesionales a convertir una idea, una necesidad o una web que quedó atrás en una base digital sólida.</p><p>La referencia del León de Hierro representa una manera de trabajar: entender el objetivo, tomar decisiones precisas, construir una base resistente y sostener el resultado.</p><p>El sitio debe sentirse firme y contemporáneo. La estética no reemplaza al criterio: lo hace visible.</p></div></div></section>
  <section id="acerca-de" class="section section--about"><div class="section__intro"><div><p class="section-label">Acerca de</p><h2>Dos personas construyendo la misma dirección.</h2></div><p>Ferlione combina desarrollo, diseño y criterio estratégico para convertir necesidades de negocio en experiencias digitales claras.</p></div><div class="team-grid"><article class="team-card"><img class="team-card__photo" src="/santi.jpeg" alt="Santino Montenegro" /><p class="team-card__index">01</p><h3>Santino Montenegro</h3><p class="team-card__role">Dirección y desarrollo</p><p>Transforma objetivos y decisiones de negocio en una web sólida, rápida y preparada para crecer.</p><span class="tag">Web · Tecnología</span></article><article class="team-card"><img class="team-card__photo" src="/tizi.jpeg" alt="Tiziano Montenegro" /><p class="team-card__index">02</p><h3>Tiziano Montenegro</h3><p class="team-card__role">Estrategia y diseño</p><p>Ordena la propuesta, la estructura y la experiencia para que cada parte de la web tenga una función clara.</p><span class="tag">Estrategia · Diseño</span></article></div></section>
  <section id="tecnologias" class="section section--muted"><div class="section__intro"><div><p class="section-label">Tecnologías</p><h2>Elegimos las herramientas según el problema.</h2></div><p>Este es el stack que manejamos para diseñar, construir y evolucionar productos digitales. La tecnología acompaña la estrategia y el alcance de cada proyecto.</p></div><div class="technology-accordion" data-technology-accordion><div class="technology-tabs" role="tablist" aria-label="Categorías de tecnologías">{technologyGroups.map((group, index) => <button class="technology-trigger" type="button" role="tab" id={`technology-tab-${index}`} aria-controls={`technology-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} data-technology-trigger={index}>{group.title}<span aria-hidden="true">+</span></button>)}</div><div class="technology-panel">{technologyGroups.map((group, index) => <ul class="technology-list" role="tabpanel" id={`technology-panel-${index}`} aria-labelledby={`technology-tab-${index}`} hidden={index !== 0}>{group.items.map((technology) => <li>{technology}</li>)}</ul>)}</div></div></section>
  <section id="proceso" class="section"><div class="section__intro"><div><p class="section-label">El proceso</p><h2>Menos incertidumbre. Mejores decisiones.</h2></div><p>El proceso convierte una idea abierta en una web que se puede explicar, usar y mejorar.</p></div><div class="process-list">{processSteps.map((step) => <div class="process-row"><span class="process-row__number">{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></div>)}</div></section>
  <section class="cta"><p class="section-label">Siguiente paso</p><h2>Cuéntame qué necesitas construir.</h2><a class="button button--light" href="#contacto">Hablemos de tu proyecto <span>↗</span></a></section>
  <section id="contacto" class="contact-grid"><div class="contact-grid__aside"><p class="section-label">Contacto</p><h2>Un buen proyecto empieza con una pregunta concreta.</h2><p>Cuéntame sobre tu negocio, la idea que quieres ordenar o el problema que tu web actual no está resolviendo.</p><p class="form-note">También puedes escribir a <a href="mailto:ferlioneagency@gmail.com">ferlioneagency@gmail.com</a>.</p><nav class="social-links" aria-label="Redes sociales"><a href="https://wa.me/542216391625?text=Hola%20Ferlione%2C%20quiero%20consultar%20por%20un%20proyecto%20web." target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a><a href="https://www.linkedin.com/in/ferlioneagency/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://www.instagram.com/ferlioneagency/" target="_blank" rel="noreferrer">Instagram <span>↗</span></a><a href="https://www.youtube.com/@ferlioneagency" target="_blank" rel="noreferrer">YouTube <span>↗</span></a><a href="https://x.com/ferlioneagency" target="_blank" rel="noreferrer">X <span>↗</span></a></nav></div><form class="contact-form" id="contact-form"><div class="field"><label for="name">Nombre</label><input id="name" name="name" required autocomplete="name" placeholder="Tu nombre" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" /></div><div class="field"><label for="project">Empresa o proyecto</label><input id="project" name="project" autocomplete="organization" placeholder="Cómo se llama" /></div><div class="field"><label for="mode">Cómo te gustaría trabajar</label><select id="mode" name="mode"><option>Proyecto puntual</option><option>Colaboración mensual</option><option>Todavía no lo sé</option></select></div><div class="field"><label for="message">Qué necesitas</label><textarea id="message" name="message" required placeholder="Cuéntame brevemente qué quieres construir o mejorar."></textarea></div><div class="form-foot"><span class="form-note">Respuesta inicial en un máximo de 2 días hábiles.</span><button class="button" type="submit">Enviar consulta <span>↗</span></button></div><div class="success-message" id="success-message" role="status">Gracias. Tu consulta quedó preparada en esta demo. Para recibir mensajes reales habrá que conectar el formulario a un endpoint.</div></form></section>
</Layout>
<script>
  import { gsap } from 'gsap';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const success = document.querySelector<HTMLElement>('#success-message');
  const bandTrack = document.querySelector<HTMLElement>('.band__track');
  const technologyAccordion = document.querySelector<HTMLElement>('[data-technology-accordion]');

  document.querySelectorAll<HTMLAnchorElement>('[data-project-link="placeholder"]').forEach((link) => {
    link.addEventListener('click', (event) => event.preventDefault());
  });

  if (bandTrack) {
    const phrase = bandTrack.querySelector<HTMLElement>('span');

    if (phrase) {
      gsap.fromTo(
        bandTrack,
        { x: 0 },
        {
          duration: 22,
          ease: 'none',
          repeat: -1,
          x: () => -phrase.getBoundingClientRect().width,
        },
      );
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    success?.classList.add('is-visible');
    form.reset();
  });

  if (technologyAccordion) {
    const triggers = Array.from(
      technologyAccordion.querySelectorAll<HTMLButtonElement>('[data-technology-trigger]'),
    );
    const panels = Array.from(
      technologyAccordion.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );

    const activateTechnology = (index: number, moveFocus = false) => {
      triggers.forEach((trigger, triggerIndex) => {
        const isActive = triggerIndex === index;
        trigger.setAttribute('aria-selected', String(isActive));
        trigger.classList.toggle('is-active', isActive);
        if (isActive && moveFocus) trigger.focus();
      });

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === index;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => activateTechnology(index));
      trigger.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const nextIndex = (index + direction + triggers.length) % triggers.length;
        activateTechnology(nextIndex, true);
      });
    });

    activateTechnology(0);
  }
</script>
