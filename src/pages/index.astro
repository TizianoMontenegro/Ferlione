---

import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import {
	pricingPlans,
	planComparison,
	problems,
	processSteps,
	projects,
	services,
} from '../data/site';

const technologyGroups = [
	{
		title: 'Frontend',
		items: [
			'HTML',
			'CSS',
			'JavaScript',
			'TypeScript',
			'React',
			'TanStack Router',
			'TanStack Query',
			'Next.js',
			'Tailwind CSS',
			'GSAP',
			'Bun',
			'Vite',
			'Biome',
		],
	},
	{
		title: 'Backend',
		items: ['Python', 'FastAPI', 'Django', 'Django REST Framework', 'JWT'],
	},
	{
		title: 'Bases de datos',
		items: ['SQL', 'PostgreSQL', 'SQLite'],
	},
	{
		title: 'Inteligencia artificial',
		items: ['LangChain', 'PyTorch', 'MCP', 'Scikit-learn', 'OpenCV', 'Gradio'],
	},
];
---
<Layout>
  <section class="hero"><div><p class="section-label">Desarrollo web · Argentina y remoto</p><h1>Diseñamos webs que ayudan a tu negocio a <em>explicar, vender y crecer.</em></h1><div class="hero__copy"><p>Ferlione combina estrategia, diseño y desarrollo para crear webs claras, rápidas y preparadas para generar nuevas oportunidades.</p><div class="hero__actions"><a class="button" href="#planes">Ver planes <span>↘</span></a><a class="button button--outline" href="#contacto">Cuéntanos qué necesitas <span>↗</span></a></div></div></div></section>
  <div class="band"><div class="band__track"><span>ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span><span aria-hidden="true">ESTRATEGIA&nbsp;·&nbsp;ESTRUCTURA&nbsp;·&nbsp;DESARROLLO&nbsp;·&nbsp;EVOLUCIÓN&nbsp;·&nbsp;</span></div></div>
  <section class="section section--muted"><div class="split-grid"><div><p class="section-label">Problemas reconocibles</p><h2>Una web puede estar frenando decisiones importantes.</h2><p class="split-grid__aside">Elige el punto que más se parece a tu situación y revisa el plan recomendado.</p></div><ul class="problem-list">{problems.map((problem) => <li><a href={problem.href}>{problem.text}<small>{problem.plan} ↘</small></a></li>)}</ul></div></section>
  <section id="planes" class="section section--pricing"><div class="section__intro"><div><p class="section-label">Planes de trabajo</p><h2>Elige el alcance que necesita tu negocio.</h2></div><p>Cada proyecto se define según alcance, contenido y complejidad. Después de la primera conversación recibirás una recomendación concreta y un presupuesto detallado.</p></div><div class="pricing-grid">{pricingPlans.map((plan, index) => <article id={`plan-${plan.slug}`} class:list={["pricing-card", { featured: index === 0 }]}><p class="pricing-card__label">{plan.label}</p><h3>{plan.title}</h3><p class="pricing-card__description">{plan.description}</p><div class="pricing-card__meta"><p><strong>Resuelve</strong>{plan.problem}</p><p><strong>Pensado para</strong>{plan.audience}</p></div><p class="pricing-card__result"><strong>Resultado esperado</strong>{plan.result}</p><p class="pricing-card__price"><strong>Duración orientativa</strong>{plan.duration}</p><ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul><a class="pricing-card__link" href="#contacto" data-plan-link={plan.slug}>{plan.cta} <span>↗</span></a></article>)}</div><div class="pricing-notes"><p><strong>Alcance:</strong> cada propuesta aclara qué incluye, qué queda fuera y qué necesita aportar el cliente.</p><p><strong>Trabajo:</strong> se define el número de rondas de cambios, la forma de pago y cómo se gestiona cualquier cambio de alcance.</p></div></section>
  <section class="section comparison-section"><div class="section__intro"><div><p class="section-label">Comparación rápida</p><h2>Encuentra tu punto de partida.</h2></div></div><div class="comparison-table"><div class="comparison-table__row comparison-table__head"><span>Necesidad</span><span>Plan recomendado</span><span>Resultado</span></div>{planComparison.map((row) => <div class="comparison-table__row"><span>{row[0]}</span><strong>{row[1]}</strong><span>{row[2]}</span></div>)}</div></section>
  <section class="section"><div class="section__intro"><div><p class="section-label">Capacidades</p><h2>Lo que podemos resolver dentro de cada proyecto.</h2></div><p>Las capacidades se combinan según el plan. No son opciones separadas: forman parte de la forma en que trabajamos.</p></div><div class="service-grid">{services.map((service) => <article class="service-item"><span class="service-item__number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><div class="tag-row">{service.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div></section>
  <section class="section section--muted monthly-section"><div class="split-grid"><div><p class="section-label">Acompañamiento mensual</p><h2>La web puede seguir mejorando después de publicarse.</h2></div><div class="case-detail__body"><p>Si necesitas mantener, optimizar o ampliar tu web, podemos seguir trabajando contigo mes a mes.</p><ul class="monthly-list"><li>Nuevas páginas y cambios de contenido</li><li>Mejoras de conversión y rendimiento</li><li>Soporte técnico e integraciones</li><li>Revisión de métricas y nuevas funcionalidades</li></ul><a class="button button--outline" href="#contacto">Consultar acompañamiento mensual <span>↗</span></a></div></div></section>
  <section class="section collaboration-section"><div class="split-grid"><div><p class="section-label">Modalidad de colaboración</p><h2>Puedes empezar con un proyecto o con acompañamiento continuo.</h2></div><div class="case-detail__body"><h3>Proyecto puntual</h3><p>Definimos alcance, entregables, calendario y puesta en marcha para construir una solución concreta.</p><h3>Colaboración mensual</h3><p>Priorizamos mejoras, contenido, soporte y nuevas funcionalidades según las necesidades del negocio.</p></div></div></section>
  <section id="trabajo" class="section section--work"><div class="section__intro"><div><p class="section-label">Trabajo seleccionado</p><h2>Proyectos con una razón para existir.</h2></div><p>Una selección de trabajos y casos conceptuales clasificados según el tipo de solución. Cada proyecto conecta un problema, unas decisiones y un resultado.</p></div><div class="projects-grid">{projects.map((project, index) => <ProjectShowcase project={project} index={index} />)}</div></section>
  <section id="sobre-ferlione" class="section section--muted"><div class="split-grid"><div><p class="section-label">Sobre Ferlione</p><h2>La fuerza está en la estructura.</h2></div><div class="case-detail__body"><p>Ferlione nace para ayudar a negocios y profesionales a convertir una idea, una necesidad o una web que quedó atrás en una base digital sólida.</p><p>La referencia del León de Hierro representa una manera de trabajar: entender el objetivo, tomar decisiones precisas, construir una base resistente y sostener el resultado.</p><p>El sitio debe sentirse firme y contemporáneo. La estética no reemplaza al criterio: lo hace visible.</p></div></div></section>
  <section id="acerca-de" class="section section--about"><div class="section__intro"><div><p class="section-label">Acerca de</p><h2>Dos personas construyendo la misma dirección.</h2></div><p>Ferlione combina desarrollo, diseño y criterio estratégico para convertir necesidades de negocio en experiencias digitales claras.</p></div><div class="team-grid"><article class="team-card"><img class="team-card__photo" src="/santi.jpeg" alt="Santino Montenegro" /><p class="team-card__index">01</p><h3>Santino Montenegro</h3><p class="team-card__role">Estrategia y diseño</p><p>Ordena la propuesta, la estructura y la experiencia para que cada parte de la web tenga una función clara.</p><span class="tag">Estrategia · Diseño</span></article><article class="team-card"><img class="team-card__photo" src="/tizi.jpeg" alt="Tiziano Montenegro" /><p class="team-card__index">02</p><h3>Tiziano Montenegro</h3><p class="team-card__role">Dirección y desarrollo</p><p>Transforma objetivos y decisiones de negocio en una web sólida, rápida y preparada para crecer.</p><span class="tag">Web · Tecnología</span></article></div></section>
  <section id="tecnologias" class="section section--muted"><div class="section__intro"><div><p class="section-label">Tecnologías</p><h2>Elegimos las herramientas según el problema.</h2></div><p>Este es el stack que manejamos para diseñar, construir y evolucionar productos digitales. La tecnología acompaña la estrategia y el alcance de cada proyecto.</p></div><div class="technology-accordion" data-technology-accordion><div class="technology-tabs" role="tablist" aria-label="Categorías de tecnologías">{technologyGroups.map((group, index) => <button class="technology-trigger" type="button" role="tab" id={`technology-tab-${index}`} aria-controls={`technology-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} data-technology-trigger={index}>{group.title}<span aria-hidden="true">+</span></button>)}</div><div class="technology-panel">{technologyGroups.map((group, index) => <ul class="technology-list" role="tabpanel" id={`technology-panel-${index}`} aria-labelledby={`technology-tab-${index}`} hidden={index !== 0}>{group.items.map((technology) => <li>{technology}</li>)}</ul>)}</div></div></section>
  <section id="proceso" class="section"><div class="section__intro"><div><p class="section-label">El proceso</p><h2>Menos incertidumbre. Mejores decisiones.</h2></div><p>El proceso convierte una idea abierta en una web que se puede explicar, usar y mejorar.</p></div><div class="process-list">{processSteps.map((step) => <div class="process-row"><span class="process-row__number">{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></div>)}</div></section>
  <section class="cta"><p class="section-label">Siguiente paso</p><h2>Cuéntame qué necesitas construir.</h2><a class="button button--light" href="#contacto">Hablemos de tu proyecto <span>↗</span></a></section>
  <section id="contacto" class="contact-grid"><div class="contact-grid__aside"><p class="section-label">Contacto</p><h2>Cuéntanos qué necesita resolver tu negocio.</h2><p>Con esta información podremos recomendarte el alcance más adecuado.</p><p class="form-note">También puedes escribir a <a href="mailto:ferlioneagency@gmail.com">ferlioneagency@gmail.com</a>.</p><nav class="social-links" aria-label="Redes sociales"><a href="https://wa.me/542216391625?text=Hola%20Ferlione%2C%20quiero%20consultar%20por%20un%20proyecto%20web." target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a><a href="https://www.linkedin.com/in/ferlioneagency/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://www.instagram.com/ferlioneagency/" target="_blank" rel="noreferrer">Instagram <span>↗</span></a><a href="https://www.youtube.com/@ferlioneagency" target="_blank" rel="noreferrer">YouTube <span>↗</span></a><a href="https://x.com/ferlioneagency" target="_blank" rel="noreferrer">X <span>↗</span></a></nav></div><form class="contact-form" id="contact-form" method="post"><div class="field"><label for="name">Nombre</label><input id="name" name="name" required autocomplete="name" placeholder="Tu nombre" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com" /></div><div class="field"><label for="project">Empresa o proyecto</label><input id="project" name="project" autocomplete="organization" placeholder="Cómo se llama" /></div><div class="field"><label for="need">Qué necesitas</label><select id="need" name="need"><option value="lanzamiento">Crear una web</option><option value="reposicionamiento">Mejorar una web existente</option><option value="sistema-digital">Construir un sistema digital</option><option value="todavia-no-lo-se">Todavía no lo sé</option></select></div><div class="field"><label for="budget">Presupuesto orientativo <span>(opcional)</span></label><select id="budget" name="budget"><option value="">Prefiero hablarlo</option><option>Menos de 1.000 USD</option><option>1.000 a 3.000 USD</option><option>Más de 3.000 USD</option></select></div><div class="field"><label for="timeline">Plazo deseado <span>(opcional)</span></label><select id="timeline" name="timeline"><option value="">Todavía no lo sé</option><option>Lo antes posible</option><option>En 1 a 2 meses</option><option>En más de 2 meses</option></select></div><div class="field"><label for="message">Descripción del proyecto</label><textarea id="message" name="message" required placeholder="Cuéntanos brevemente qué quieres construir o mejorar."></textarea></div><div class="form-foot"><span class="form-note">Respuesta en un máximo de 2 días hábiles.</span><button class="button" type="submit">Enviar consulta <span>↗</span></button></div><div class="success-message" id="success-message" role="status" tabindex="-1">Recibimos tu consulta. Revisaremos la información y te responderemos en un máximo de 2 días hábiles con los siguientes pasos.</div></form></section>
</Layout>
<script>
  import { gsap } from 'gsap';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const success = document.querySelector<HTMLElement>('#success-message');
  const bandTrack = document.querySelector<HTMLElement>('.band__track');
  const technologyAccordion = document.querySelector<HTMLElement>('[data-technology-accordion]');
  const needSelect = document.querySelector<HTMLSelectElement>('#need');

  document.querySelectorAll<HTMLAnchorElement>('[data-plan-link]').forEach((link) => {
    link.addEventListener('click', () => {
      const plan = link.getAttribute('data-plan-link');
      if (plan && needSelect?.querySelector(`option[value="${plan}"]`)) {
        needSelect.value = plan;
      }
    });
  });

  if (bandTrack) {
    const phrase = bandTrack.querySelector<HTMLElement>('span');

    if (phrase) {
      gsap.fromTo(
        bandTrack,
        { x: 0 },
        {
          duration: 22,
          ease: 'none',
          repeat: -1,
          x: () => -phrase.getBoundingClientRect().width,
        },
      );
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    success?.classList.add('is-visible');
    success?.focus();
    form.reset();
  });

  if (technologyAccordion) {
    const triggers = Array.from(
      technologyAccordion.querySelectorAll<HTMLButtonElement>('[data-technology-trigger]'),
    );
    const panels = Array.from(
      technologyAccordion.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );

    const activateTechnology = (index: number, moveFocus = false) => {
      triggers.forEach((trigger, triggerIndex) => {
        const isActive = triggerIndex === index;
        trigger.setAttribute('aria-selected', String(isActive));
        trigger.classList.toggle('is-active', isActive);
        if (isActive && moveFocus) trigger.focus();
      });

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === index;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => activateTechnology(index));
      trigger.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const nextIndex = (index + direction + triggers.length) % triggers.length;
        activateTechnology(nextIndex, true);
      });
    });

    activateTechnology(0);
  }
</script>
