---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';
---
<Layout title="Servicios — Ferlione"><section class="page-hero"><p class="section-label">Servicios</p><h1>De la idea al sitio publicado.</h1><p>Elegimos el alcance según lo que el negocio necesita resolver. Puedes llegar con una idea clara o con un problema que todavía necesita estructura.</p></section><section class="section"><div class="service-grid">{services.map((service) => <article class="service-item"><span class="service-item__number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p><div class="tag-row">{service.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div></section><section class="section section--muted"><div class="split-grid"><div><p class="section-label">Dos formas de empezar</p><h2>La idea puede estar clara o todavía no.</h2></div><div class="case-detail__body"><h3>Proyecto puntual</h3><p>Definimos alcance, entregables, calendario y puesta en marcha para construir una web concreta.</p><h3>Colaboración mensual</h3><p>Priorizamos soporte, contenido, optimización o nuevas funcionalidades según lo que el negocio necesite cada mes.</p><a class="button" href="/contacto/">Cuéntame dónde estás <span>↗</span></a></div></div></section></Layout>
