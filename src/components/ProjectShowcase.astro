---
import ProjectGallery from './ProjectGallery.astro';
import type { projects } from '../data/site';

type Project = (typeof projects)[number];
const { project, index } = Astro.props as { project: Project; index: number };
const variants = ['feature', 'reverse', 'editorial'] as const;
const variant = variants[index % variants.length];
---
<article class={`project-showcase project-showcase--${variant}`}>
  <div class="project-showcase__visual"><ProjectGallery project={project} /></div>
  <div class="project-showcase__intro">
    <p class="section-label">{project.category} · {project.year}</p>
    <h3>{project.name}</h3>
    <p class="project-showcase__summary">{project.summary}</p>
    <div class="project-showcase__facts">
      <span>{project.service}</span>
      <span>{project.deliverables.length} entregables</span>
    </div>
    <a
      class="project-showcase__link button button--outline"
      href={project.url ?? '#'}
      target={project.url ? '_blank' : undefined}
      rel={project.url ? 'noreferrer' : undefined}
      data-project-link={project.url ? undefined : 'placeholder'}
    >
      Ver página del proyecto <span>↗</span>
    </a>
  </div>
  <div class="project-showcase__details">
    <div class="project-showcase__detail">
      <p class="eyebrow">Problema</p>
      <p>{project.problem}</p>
    </div>
    <div class="project-showcase__detail">
      <p class="eyebrow">Solución</p>
      <p>{project.solution}</p>
    </div>
    <div class="project-showcase__detail">
      <p class="eyebrow">Resultado esperado</p>
      <p>{project.expectedResult}</p>
    </div>
    <div class="project-showcase__detail project-showcase__deliverables">
      <p class="eyebrow">Entregables</p>
      <ul class="deliverables">{project.deliverables.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>
</article>
