---
import '../styles/global.css';
interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'Ferlione — Desarrollo web con estrategia',
	description = 'Ferlione convierte ideas y necesidades de negocio en webs sólidas, claras y preparadas para crecer.',
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><meta name="generator" content={Astro.generator} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>{title}</title></head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Ferlione, inicio"><img class="wordmark__logo" src="/ferlione-logo.png" alt="" /><span>FERLIONE</span></a>
      <nav class="desktop-nav" aria-label="Navegación principal"><a class:list={[{ active: path === '/trabajo/' }]} href="/trabajo/">Trabajo</a><a class:list={[{ active: path === '/servicios/' }]} href="/servicios/">Servicios</a><a class:list={[{ active: path === '/proceso/' }]} href="/proceso/">Proceso</a><a class:list={[{ active: path === '/sobre-ferlione/' }]} href="/sobre-ferlione/">Ferlione</a></nav>
      <a class="header-cta" href="/contacto/">Hablemos <span>↗</span></a>
      <details class="mobile-nav"><summary aria-label="Abrir menú">Menú</summary><nav aria-label="Navegación móvil"><a href="/trabajo/">Trabajo</a><a href="/servicios/">Servicios</a><a href="/proceso/">Proceso</a><a href="/sobre-ferlione/">Ferlione</a><a href="/contacto/">Contacto</a></nav></details>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><div><p class="footer-kicker">León de hierro</p><p class="footer-title">Una base digital preparada para crecer.</p></div><a class="button button--light" href="/contacto/">Cuéntame tu idea <span>↗</span></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Ferlione</span><span>Argentina · Trabajo remoto</span><a href="mailto:hola@ferlione.com">hola@ferlione.com</a></div></footer>
    <script>
      const header = document.querySelector('.site-header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 0);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
  </body>
</html>
