---
import '../styles/global.css';
interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'Ferlione — Desarrollo web con estrategia',
	description = 'Ferlione convierte ideas y necesidades de negocio en webs sólidas, claras y preparadas para crecer.',
} = Astro.props;
const siteUrl = 'https://ferlione.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const socialImage = new URL('/ferlione-logo.png', siteUrl).toString();
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Ferlione',
	description,
	url: siteUrl,
	logo: socialImage,
	email: 'ferlioneagency@gmail.com',
	areaServed: 'AR',
	serviceType: 'Desarrollo web',
	address: {
		'@type': 'PostalAddress',
		addressCountry: 'AR',
	},
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Ferlione" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/my-favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/my-favicon/favicon.svg" />
    <link rel="shortcut icon" href="/my-favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/my-favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Ferlione" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/my-favicon/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Ferlione" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wordmark" aria-label="Ferlione"><img class="wordmark__logo" src="/ferlione-logo.png" alt="" /><span>FERLIONE</span></div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><div><p class="footer-kicker">León de hierro</p><p class="footer-title">Una base digital preparada para crecer.</p></div><img class="footer-logo" src="/ferlione-logo.png" alt="Ferlione" /></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Ferlione (Santino Montenegro y Tiziano Montenegro)</span><span>Argentina · Trabajo remoto internacional</span><a href="mailto:ferlioneagency@gmail.com">ferlioneagency@gmail.com</a></div></footer>
    <script>
      const header = document.querySelector('.site-header');
      const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 0);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    </script>
  </body>
</html>
